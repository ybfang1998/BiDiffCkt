simulator lang = spectre
global 0

// include the pdk path
// sample pdk import
include "/data/tools/PDKs/TSMC/europractice/extracted/65/CMOS/LP/pdk/cadence_oa/tsmcN65/../models/spectre/toplevel.scs" section=tt_lib


parameters VDD_VAL=1.2
V1 (Vdd 0) vsource dc=VDD_VAL xfmag=1
// Specify input DC Bias
Vinp (VINP 0) vsource dc=VDD_VAL/2

//Optional: input DC Bias with trans analysis
//Vinp (VINP 0) vsource dc=VDD_VAL/2 type=pulse val0=0 val1=1.2 period=40u rise=1n fall=1n width=20u

// CMOS pins sequence: (D G S B)

IBIASN_I_ref (Vdd IBIASN) isource dc=1uA
IBIASN_M_bias (IBIASN IBIASN 0 0) nch w=1u l=1u

subckt current_mirror_pmos_1 In Out Sources VDD
    parameters W=1u L=1u
    M1 (In In Sources VDD) pch w=W l=L
    M2 (Out In Sources VDD) pch w=W l=L
ends current_mirror_pmos_1

subckt diff_pair_nmos_1 InP InN OutP OutN Sources VSS
    parameters W=1u L=1u
    M1 (OutP InP Sources VSS) nch w=W l=L
    M2 (OutN InN Sources VSS) nch w=W l=L
ends diff_pair_nmos_1

I0 (net1 net3 Vdd Vdd) current_mirror_pmos_1 W=1 L=1
I1 (Vout IBIASN 0 0) nch w=1 l=1
I2 (VINN VINP net1 net3 net2 0) diff_pair_nmos_1 W=1 L=1
I3 (net2 IBIASN 0 0) nch w=1 l=1
I4 (net3 Vout) capacitor c=1
I5 (Vout net3 Vdd Vdd) pch w=1 l=1

// Load and IProbe
C_Load (Vout 0) capacitor c=1e-12
Iprobe1 (VINN Vout) iprobe

//Simulation Setting
stb stb start=1 stop=1e11 log=1000 probe=Iprobe1 localgnd=0 annotate=status
dcOp dc write="spectre.dc" maxiters=150 maxsteps=10000 annotate=status
dcOpInfo info what=oppoint where=rawfile
//XF analysis for PSRR
xf ( Vout 0 ) xf start=1 stop=1e11 annotate=status

// trans analysis for slew rate
//tran tran stop=1m errpreset=conservative write="spectre.ic" writefinal="spectre.fc" annotate=status maxiters=5
