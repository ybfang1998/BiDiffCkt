simulator lang = spectre
global 0

// include the pdk path
// sample pdk import
include "/data/tools/PDKs/TSMC/europractice/extracted/65/CMOS/LP/pdk/cadence_oa/tsmcN65/../models/spectre/toplevel.scs" section=tt_lib


parameters VDD_VAL=1.2
V1 (Vdd 0) vsource dc=VDD_VAL
Vinp (VIN 0) vsource dc=VDD_VAL/2

V_DM_pos (VINP VIN) vsource dc=0 mag=1
V_DM_neg (VINN Vout) vsource dc=0 mag=1

// CMOS pins sequence: (D G S B)

IBIASN_I_ref (Vdd IBIASN) isource dc=1uA
IBIASN_M_bias (IBIASN IBIASN 0 0) nch w=1u l=1u

subckt diff_pair_nmos_1 InP InN OutP OutN Sources VSS
    parameters W=1u L=1u
    M1 (OutP InP Sources VSS) nch w=W l=L
    M2 (OutN InN Sources VSS) nch w=W l=L
ends diff_pair_nmos_1

subckt current_mirror_pmos_1 In Out Sources VDD
    parameters W=1u L=1u
    M1 (In In Sources VDD) pch w=W l=L
    M2 (Out In Sources VDD) pch w=W l=L
ends current_mirror_pmos_1

subckt current_mirror_pmos_2 In Out Sources VDD
    parameters W=1u L=1u
    M1 (In In Sources VDD) pch w=W l=L
    M2 (Out In Sources VDD) pch w=W l=L
ends current_mirror_pmos_2

I0 (net2 net1 0 0) nch w=1 l=1
I1 (VINN VINP net6 net1 net3 0) diff_pair_nmos_1 W=1 L=1
I2 (net4 Vout) resistor r=1
I3 (net5 IBIASN 0 0) nch w=1 l=1
I4 (net1 net4) capacitor c=1
I5 (net6 net1 Vdd Vdd) current_mirror_pmos_1 W=1 L=1
I6 (Vout IBIASN 0 0) nch w=1 l=1
I7 (net5 net4) capacitor c=1
I8 (Vout net5 Vdd Vdd) pch w=1 l=1
I9 (net3 IBIASN 0 0) nch w=1 l=1
I10 (net2 net5 Vdd Vdd) current_mirror_pmos_2 W=1 L=1

// Load and IProbe
C_Load (Vout 0) capacitor c=1e-12

//Simulation Setting
ac ac start=1 stop=1e11 annotate=status
