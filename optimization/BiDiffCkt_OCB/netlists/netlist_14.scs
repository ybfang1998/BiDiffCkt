simulator lang=spectre
global 0

subckt tc_stage_neg_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=-0.10818534092966191m 
    R0 (OUT GND) resistor r=0.5730905820254345M 
    C0 (IN GND) capacitor c=0.08613482558094102p 
ends tc_stage_neg_1 
subckt tc_stage_neg_2 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=-0.27347504760640856m 
    R0 (OUT GND) resistor r=0.14626562953402936M 
    C0 (IN GND) capacitor c=0.2177349105146565p 
ends tc_stage_neg_2 
subckt ts_c_p_1 GND IN OUT 
    C1 (IN OUT) capacitor c=5.998495903505288p 
    G0 (OUT GND IN GND) vccs gm=0.9735811243489149m 
    R0 (OUT GND) resistor r=0.07087236828481443M 
    C0 (IN GND) capacitor c=0.7751442072841679p 
ends ts_c_p_1 
subckt tc_stage_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=0.3337599956085985m 
    R0 (OUT GND) resistor r=0.12883509277854333M 
    C0 (IN GND) capacitor c=0.2657324805800943p 
ends tc_stage_1 
subckt single_r_1 IN OUT 
    R0 (IN OUT) resistor r=0.7490425584984229M 
ends single_r_1 

I0 (0 OUT net1) tc_stage_neg_1
I1 (0 VIN net2) tc_stage_neg_2
I2 (0 net2 net1) ts_c_p_1
I3 (0 net1 OUT) tc_stage_1
I4 (net1 OUT) single_r_1
V0 (VIN 0) vsource dc=0 mag=1m type=sine ampl=1m freq=1K 

C_L (OUT 0) capacitor c=10p  
R_L (OUT 0) resistor r=10M  

ac ac start=1 stop=1e9 dec=100 annotate=status 
