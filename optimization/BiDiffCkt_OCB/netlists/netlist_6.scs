    R0 (OUT GND) resistor r=0.2174355677226572M 
    C0 (IN GND) capacitor c=0.2380088634932898p 
ends tc_stage_neg_1 
subckt tc_stage_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=0.048741529787054684m 
