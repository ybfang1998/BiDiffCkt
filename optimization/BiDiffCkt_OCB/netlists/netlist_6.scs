    C0 (IN GND) capacitor c=0.03880695046740022p 
ends tc_stage_1 
subckt single_c_1 IN OUT 
    C0 (IN OUT) capacitor c=2.9403909839199374p 
ends single_c_1 
subckt ts_c_p_neg_1 GND IN OUT 
    C1 (IN OUT) capacitor c=3.0050318181999423p 
    G0 (OUT GND IN GND) vccs gm=-0.7195483041227753m 
    R0 (OUT GND) resistor r=0.10979110026019931M 
    C0 (IN GND) capacitor c=0.5728887771678147p 
ends ts_c_p_neg_1 
subckt ts_c_p_1 GND IN OUT 
