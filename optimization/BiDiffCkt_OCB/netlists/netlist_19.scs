simulator lang=spectre
global 0

subckt tc_stage_neg_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=-0.8223349001641129m 
    R0 (OUT GND) resistor r=0.09363581672702101M 
    C0 (IN GND) capacitor c=0.6547252389841663p 
ends tc_stage_neg_1 
subckt tc_stage_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=0.6851016575015564m 
    R0 (OUT GND) resistor r=0.08757824381685093M 
    C0 (IN GND) capacitor c=0.5454631031063347p 
ends tc_stage_1 
subckt single_r_1 IN OUT 
    R0 (IN OUT) resistor r=0.6066480516718921M 
ends single_r_1 

I0 (0 VIN net1) tc_stage_neg_1
I1 (0 net1 OUT) tc_stage_1
I2 (net1 OUT) single_r_1
V0 (VIN 0) vsource dc=0 mag=1m type=sine ampl=1m freq=1K 

C_L (OUT 0) capacitor c=10p  
R_L (OUT 0) resistor r=10M  

ac ac start=1 stop=1e9 dec=100 annotate=status 
