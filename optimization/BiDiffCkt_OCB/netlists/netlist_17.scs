simulator lang=spectre
global 0

subckt tc_stage_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=0.6913707511187783m 
    R0 (OUT GND) resistor r=0.05930247979633745M 
    C0 (IN GND) capacitor c=0.550454419680556p 
ends tc_stage_1 
subckt tc_stage_neg_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=-0.07770959945386849m 
    R0 (OUT GND) resistor r=0.8621843436443636M 
    C0 (IN GND) capacitor c=0.06187070020212459p 
ends tc_stage_neg_1 
subckt ts_r_p_neg_1 GND IN OUT 
    R1 (IN OUT) resistor r=0.29255024866658336M 
    G0 (OUT GND IN GND) vccs gm=-0.46835601146205397m 
    R0 (OUT GND) resistor r=0.11102665222054703M 
    C0 (IN GND) capacitor c=0.3728949135844378p 
ends ts_r_p_neg_1 
subckt ts_c_p_neg_1 GND IN OUT 
    C1 (IN OUT) capacitor c=5.536731530481248p 
    G0 (OUT GND IN GND) vccs gm=-0.715805230075831m 
    R0 (OUT GND) resistor r=0.0908068246345644M 
    C0 (IN GND) capacitor c=0.56990862267184p 
ends ts_c_p_neg_1 

I0 (0 net2 net1) tc_stage_1
I1 (0 net1 OUT) tc_stage_neg_1
I2 (0 net1 OUT) ts_r_p_neg_1
I3 (0 VIN net2) ts_c_p_neg_1
V0 (VIN 0) vsource dc=0 mag=1m type=sine ampl=1m freq=1K 

C_L (OUT 0) capacitor c=10p  
R_L (OUT 0) resistor r=10M  

ac ac start=1 stop=1e9 dec=100 annotate=status 
