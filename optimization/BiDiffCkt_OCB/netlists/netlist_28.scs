simulator lang=spectre
global 0

subckt tc_stage_neg_1 GND IN OUT 
    G0 (OUT GND IN GND) vccs gm=-0.9727926561209448m 
    R0 (OUT GND) resistor r=0.04111873146689021M 
    C0 (IN GND) capacitor c=0.7745164459561662p 
ends tc_stage_neg_1 
subckt ts_c_p_1 GND IN OUT 
    C1 (IN OUT) capacitor c=6.348500109282126p 
    G0 (OUT GND IN GND) vccs gm=0.011356042633265779m 
    R0 (OUT GND) resistor r=4.491001103729864M 
    C0 (IN GND) capacitor c=0.009041435217568295p 
ends ts_c_p_1 
subckt single_r_1 IN OUT 
